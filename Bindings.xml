<Bindings>
	<Binding name="SERENE_PEEK" runOnUp="true" category="BINDING_HEADER_SERENE">
		Serene_Peek(keystate)
	</Binding>
	<Binding name="SERENE_TRACKER" category="BINDING_HEADER_SERENE">
